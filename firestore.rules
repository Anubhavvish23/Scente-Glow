rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function is_admin() {
      return request.auth != null
        && request.auth.token.email == "scenteglow@protonmail.com";
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if is_admin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if is_admin();
    }

    match /stats/{docId} {
      allow read: if is_admin();
      allow write: if true;
    }
  }
}
